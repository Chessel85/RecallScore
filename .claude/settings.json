{
  "permissions": {
    "allow": [
      "Bash(.venv/Scripts/python.exe -m pytest *)",
      "Bash(.venv/Scripts/python.exe tests/manual/model_fingerprint.py *)",
      "Bash(.venv/Scripts/python.exe tests/manual/parser_fingerprint.py *)",
      "Bash(git worktree add *)",
      "Bash(git worktree remove *)",
      "Bash(rm -rf /c/Temp/*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/write_last_response.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
