<?xml version="1.0" encoding="UTF-8"?>
<!-- Stage 7 (MusicXMLMarkingInventory.md #8): <barline>/<segno> and
     <barline>/<coda> as an alternative source for jump marks, alongside the
     <direction> form. Bar 1's right barline carries a <segno/>; bar 2's
     right barline carries a <coda/>. Neither has a sibling <sound>, so both
     get the same "1"/"" defaults as the no-<sound> <direction> fallback. -->
<score-partwise version="4.0">
  <part-list>
    <score-part id="P1"><part-name>Test Part</part-name>
      <midi-instrument id="P1-I1"><midi-channel>1</midi-channel><midi-program>1</midi-program></midi-instrument>
    </score-part>
  </part-list>
  <part id="P1">
    <measure number="1">
      <attributes>
        <divisions>1</divisions>
        <key><fifths>0</fifths></key>
        <time><beats>4</beats><beat-type>4</beat-type></time>
        <clef number="1"><sign>G</sign><line>2</line></clef>
      </attributes>
      <note><pitch><step>C</step><octave>4</octave></pitch>
        <duration>4</duration><voice>1</voice><type>whole</type><staff>1</staff></note>
      <barline location="right"><segno/></barline>
    </measure>
    <measure number="2">
      <note><pitch><step>D</step><octave>4</octave></pitch>
        <duration>4</duration><voice>1</voice><type>whole</type><staff>1</staff></note>
      <barline location="right"><coda/></barline>
    </measure>
  </part>
</score-partwise>
