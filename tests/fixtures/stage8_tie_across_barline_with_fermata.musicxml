<?xml version="1.0" encoding="UTF-8"?>
<!-- Stage 8: a tie across a barline (bar 1's C4 -> bar 2's C4, merging to
     one attack of quarter_length 8.0) with a fermata on that SAME barline.
     The two mechanisms are independent: the tied continuation vanishes
     from the timeline (nothing beyond the tie), and the barline fermata
     still gets its own moment event at that exact boundary. -->
<score-partwise version="4.0">
  <part-list>
    <score-part id="P1"><part-name>Test Part</part-name>
      <midi-instrument id="P1-I1"><midi-channel>1</midi-channel><midi-program>1</midi-program></midi-instrument>
    </score-part>
  </part-list>
  <part id="P1">
    <measure number="1">
      <attributes>
        <divisions>1</divisions>
        <key><fifths>0</fifths></key>
        <time><beats>4</beats><beat-type>4</beat-type></time>
        <clef number="1"><sign>G</sign><line>2</line></clef>
      </attributes>
      <note><pitch><step>C</step><octave>4</octave></pitch>
        <duration>4</duration><voice>1</voice><type>whole</type><staff>1</staff>
        <notations><tied type="start"/></notations>
      </note>
      <barline location="right"><fermata/></barline>
    </measure>
    <measure number="2">
      <note><pitch><step>C</step><octave>4</octave></pitch>
        <duration>4</duration><voice>1</voice><type>whole</type><staff>1</staff>
        <notations><tied type="stop"/></notations>
      </note>
    </measure>
  </part>
</score-partwise>
