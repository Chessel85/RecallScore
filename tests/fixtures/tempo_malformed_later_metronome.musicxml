<?xml version="1.0" encoding="UTF-8"?>
<!-- One part, two complete 4/4 bars. The opening marking is a well-formed
     Largo quarter=52. Bar 2 carries a MALFORMED <metronome> with an empty
     <beat-unit> and no <per-minute> - exactly what MuseScore emitted in
     files/ManyParts/dvorak-symphony-no-9-new-world-ii-largo.mxl, and what
     makes music21's whole parse abort.

     MusicXMLReader must still report the opening tempo as 52 (from the
     ElementTree scan), not fall back to 120. -->
<score-partwise version="4.0">
  <part-list>
    <score-part id="P1">
      <part-name>Test Part</part-name>
      <midi-instrument id="P1-I1">
        <midi-channel>1</midi-channel>
        <midi-program>1</midi-program>
      </midi-instrument>
    </score-part>
  </part-list>
  <part id="P1">
    <measure number="1">
      <attributes>
        <divisions>1</divisions>
        <key><fifths>0</fifths></key>
        <time><beats>4</beats><beat-type>4</beat-type></time>
        <clef number="1"><sign>G</sign><line>2</line></clef>
      </attributes>
      <direction placement="above">
        <direction-type>
          <words font-weight="bold">Largo</words>
        </direction-type>
        <direction-type>
          <metronome>
            <beat-unit>quarter</beat-unit>
            <per-minute>52</per-minute>
          </metronome>
        </direction-type>
        <sound tempo="52"/>
      </direction>
      <note>
        <pitch><step>C</step><octave>4</octave></pitch>
        <duration>4</duration>
        <voice>1</voice>
        <type>whole</type>
        <staff>1</staff>
      </note>
    </measure>
    <measure number="2">
      <direction placement="above">
        <direction-type>
          <metronome>
            <beat-unit></beat-unit>
          </metronome>
        </direction-type>
      </direction>
      <note>
        <pitch><step>D</step><octave>4</octave></pitch>
        <duration>4</duration>
        <voice>1</voice>
        <type>whole</type>
        <staff>1</staff>
      </note>
    </measure>
  </part>
</score-partwise>
